# Copy these settings into your local .env and fill in your own values.
SECRET_KEY=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-valid-Fernet-key
DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/AssetVerifyApp?charset=utf8mb4
ADMIN_PASSWORD=choose-a-strong-admin-password
FLASK_DEBUG=false
PORT=5013

# Configure these SMTP values to send approval notifications to administrators.
# For Gmail, use an App Password in SMTP_PASSWORD (not your normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_USE_TLS=true
SMTP_FROM=your-account@gmail.com
ASSET_APPROVAL_EMAIL=admin@example.com

# Docker Compose MySQL settings (use letters and numbers in MYSQL_PASSWORD)
MYSQL_DATABASE=asset_verification
MYSQL_USER=assetverify_app
MYSQL_PASSWORD=replace-with-a-unique-alphanumeric-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-alphanumeric-password
